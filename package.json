{
  "name": "clora",
  "version": "1.1.0",
  "description": "Clora — facturation, devis et suivi financier pour PME canadiennes",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "electron:dev": "concurrently \"cd client && npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && electron-builder",
    "start:server": "node server.js",
    "start:client": "cd client && npm run dev",
    "db:init": "node database.js",
    "seed:demo": "node database.js --seed",
    "test": "node --test \"tests/**/*.test.js\"",
    "doctor": "node doctor.js"
  },
  "build": {
    "appId": "com.safehill.clora",
    "productName": "Clora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "*.js",
      "routes/**/*.js",
      "package.json",
      "client/dist/**/*",
      "!reset_data.js",
      "!tests/**",
      "!database.sqlite",
      "!.env",
      "!.jwt-secret"
    ],
    "extraResources": [
      {
        "from": "image",
        "to": "image"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "image/logo2.ico"
    }
  },
  "keywords": [
    "facturation",
    "devis",
    "TPS",
    "TVQ",
    "PME"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.10",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "wait-on": "^9.0.10"
  }
}
